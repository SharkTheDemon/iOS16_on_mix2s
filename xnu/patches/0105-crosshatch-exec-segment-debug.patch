 #include <kern/debug.h>
 #include <sys/sysctl.h>
+#include <sys/systm.h>
 
 /*
  * SWEET exec debug: instrument every LOAD_BADMACHO return in load_segment
@@ -100,6 +101,10 @@ load_segment(
 		goto out;
 	}
 
+	printf("SWEET LOAD_SEG: %s vmaddr=0x%llx vmsize=0x%llx fileoff=0x%llx filesize=0x%llx macho_size=0x%llx PAGE_SIZE=0x%lx\n",
